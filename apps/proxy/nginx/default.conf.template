# Plane full-local reverse proxy (nginx).
# envsubst replaces ${BUCKET_NAME} and ${FILE_SIZE_LIMIT_MB} at container start.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

upstream plane_web {
    server web:3000;
}

upstream plane_admin {
    server admin:3000;
}

upstream plane_space {
    server space:3000;
}

upstream plane_live {
    server live:3000;
}

upstream plane_api {
    server api:8000;
}

upstream plane_minio {
    server plane-minio:9000;
}

server {
    listen 80;
    server_name _;

    client_max_body_size ${FILE_SIZE_LIMIT_MB}m;
    large_client_header_buffers 4 32k;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Trailing-slash redirects (match Caddyfile)
    location = /spaces {
        return 301 /spaces/;
    }

    location = /god-mode {
        return 301 /god-mode/;
    }

    location /spaces/ {
        proxy_pass http://plane_space;
    }

    location /god-mode/ {
        proxy_pass http://plane_admin;
    }

    location /live/ {
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_pass http://plane_live;
    }

    location /api/ {
        proxy_pass http://plane_api;
    }

    location /auth/ {
        proxy_pass http://plane_api;
    }

    location /static/ {
        proxy_pass http://plane_api;
    }

    location /${BUCKET_NAME}/ {
        proxy_pass http://plane_minio;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location = /${BUCKET_NAME} {
        proxy_pass http://plane_minio;
        proxy_buffering off;
        proxy_request_buffering off;
    }

    location / {
        proxy_pass http://plane_web;
    }
}
