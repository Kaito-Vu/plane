# syntax=docker/dockerfile:1.7

# *****************************************************************************
# STAGE 1: shared base (OS patches only, cached until the base image or
# APK_SECURITY_PATCH changes)
# *****************************************************************************
FROM python:3.14.7-alpine AS base

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PIP_DISABLE_PIP_VERSION_CHECK=1

# OS security updates. --available forces reinstall from the current repos;
# bump APK_SECURITY_PATCH to bust buildx's cached layer (keyed on this command
# string), otherwise a rebuild silently re-ships the old packages.
ARG APK_SECURITY_PATCH=2026-09-07
RUN echo "apk-security-patch ${APK_SECURITY_PATCH}" && apk update && apk upgrade --no-cache --available

# *****************************************************************************
# STAGE 2: build Python wheels with the compiler toolchain
# (the toolchain never reaches the runtime image)
# *****************************************************************************
FROM base AS builder

RUN apk add --no-cache \
    "bash~=5.3" \
    "g++" \
    "gcc" \
    "cargo" \
    "git" \
    "make" \
    "libffi-dev" \
    "postgresql-dev" \
    "libc-dev" \
    "linux-headers"

WORKDIR /code

# Only the requirement files, so code changes never invalidate the install layer
COPY requirements.txt ./
COPY requirements ./requirements

RUN --mount=type=cache,id=pip-cache,target=/root/.cache/pip \
    pip install --prefix=/install -r requirements.txt --compile

# *****************************************************************************
# STAGE 3: runtime image
# *****************************************************************************
FROM base AS runtime

ENV INSTANCE_CHANGELOG_URL=https://sites.plane.so/pages/691ef037bcfe416a902e48cb55f59891/

WORKDIR /code

RUN apk add --no-cache --upgrade \
    "bash~=5.3" \
    "libpq" \
    "libxslt" \
    "xmlsec" \
    "ca-certificates" \
    "openssl"

# Installed packages and console scripts land in /usr/local, same as before
COPY --from=builder /install /usr/local

# Application code (changes most often, so it comes last)
COPY manage.py manage.py
COPY plane plane/
COPY templates templates/
COPY package.json package.json
COPY ./bin ./bin/

RUN mkdir -p /code/plane/logs && chmod +x ./bin/* && chmod -R 777 /code

EXPOSE 8000

CMD ["./bin/docker-entrypoint-api.sh"]
