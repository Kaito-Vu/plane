# Copy to .env.prod on the prod server and fill in.
TAG=prod
SITE_ADDRESS=:80
LISTEN_HTTP_PORT=80
LISTEN_HTTPS_PORT=443

DEBUG=0
WEB_URL="http://CHANGE_ME"
ADMIN_BASE_URL="http://CHANGE_ME/god-mode"
CORS_ALLOWED_ORIGINS="http://CHANGE_ME"
SECRET_KEY="CHANGE_ME"
GUNICORN_WORKERS=2

# External Postgres
POSTGRES_HOST="10.0.222.81"
POSTGRES_PORT=5432
POSTGRES_USER="plane"
POSTGRES_PASSWORD="CHANGE_ME"
POSTGRES_DB="plane"
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

REDIS_HOST="plane-redis"
REDIS_PORT="6379"
REDIS_URL="redis://plane-redis:6379/"

RABBITMQ_HOST="plane-mq"
RABBITMQ_PORT="5672"
RABBITMQ_USER="plane"
RABBITMQ_PASSWORD="CHANGE_ME"
RABBITMQ_VHOST="plane"
AMQP_URL="amqp://${RABBITMQ_USER}:${RABBITMQ_PASSWORD}@${RABBITMQ_HOST}:${RABBITMQ_PORT}/${RABBITMQ_VHOST}"

USE_MINIO=1
AWS_REGION=""
AWS_ACCESS_KEY_ID="CHANGE_ME"
AWS_SECRET_ACCESS_KEY="CHANGE_ME"
AWS_S3_ENDPOINT_URL="http://plane-minio:9000"
AWS_S3_BUCKET_NAME="uploads"
FILE_SIZE_LIMIT=5242880
DATA_DIR=./data

# Only god-mode (super admin) can create workspaces; POST workspaces/ returns 403, god-mode is unaffected.
# NOTE: this variable only SEEDS the value on a fresh install (configure_instance only get_or_creates the InstanceConfiguration row).
# Existing instance: turn it on in god-mode (Workspace > 'Prevent anyone else from creating a workspace') or edit the DB row.
# Check: GET /api/instances/ -> is_workspace_creation_disabled = true.
DISABLE_WORKSPACE_CREATION=1

# Live (collaborative editing) server. LIVE_SERVER_SECRET_KEY must be identical for api and live.
# Generate with: openssl rand -hex 32
API_BASE_URL="http://api:8000"
LIVE_SERVER_SECRET_KEY="CHANGE_ME"

# MinIO exposed on the host. Console/API login = AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (user / password).
# Changing those keys also changes what the api uses, so recreate api, worker, beat-worker and plane-minio together.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9090
